# ----------------------------------------------------------------- UTIL
def norm(s: str) -> str:
    s = unicodedata.normalize("NFKD", str(s))
    return "".join(c for c in s if not unicodedata.combining(c)).upper().strip()


def ler_csv(caminho):
    for enc in ("utf-8-sig", "latin-1", "cp1252"):
        try:
            return pd.read_csv(caminho, sep=None, engine="python",
                               encoding=enc, dtype=str,
                               keep_default_na=False, na_values=[""])
        except UnicodeDecodeError:
            continue
    raise RuntimeError("Não consegui ler o CSV (encoding).")


def salvar_csv(df):
    """Gravação atômica (.tmp -> replace)."""
    tmp = CSV_SAIDA + ".tmp"
    df.to_csv(tmp, index=False, encoding="utf-8-sig", sep=";")
    for _ in range(10):
        try:
            os.replace(tmp, CSV_SAIDA)
            return
        except PermissionError:
            time.sleep(1)
    log.error(f"não consegui substituir {CSV_SAIDA} (arquivo aberto?); "
              f"o checkpoint mais recente está em {tmp}")
    tqdm.write(f"AVISO: {CSV_SAIDA} está aberto; checkpoint salvo em {tmp}")


def localizar_arquivo(row) -> Path | None:
    p = Path(str(row["arquivo"]).strip())
    if p.exists():
        return p
    p2 = PASTA_ORIGEM / p.name
    if p2.exists():
        return p2
    achados = list(PASTA_ORIGEM.glob(f"{row['codProcesso']}-*_{row['codDocumento']}_*"))
    return achados[0] if achados else None


def para_numero(v):
    if v is None or isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return float(v)
    s = str(v).strip()
    if s.upper() in ("", "N/A", "NULL", "NONE"):
        return None
    s = re.sub(r"[^\d,.\-]", "", s)
    if "," in s:
        s = s.replace(".", "").replace(",", ".")
    try:
        return float(s)
    except ValueError:
        return None


def normaliza_sim_nao(v):
    if v is None:
        return None
    if isinstance(v, bool):
        return "Sim" if v else "Não"
    n = norm(v)
    if n in ("TRUE", "YES"):
        return "Sim"
    if n in ("FALSE", "NO"):
        return "Não"
    if n.startswith("S"):
        return "Sim"
    if n.startswith("N") and n not in ("N/A", "NULL", "NONE"):
        return "Não"
    return None


